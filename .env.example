VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Paynow credentials are server-side only (Edge Function secrets) — never add
# them here as VITE_* vars, that would expose them to the browser. Set them with:
#   supabase secrets set PAYNOW_INTEGRATION_ID=... PAYNOW_INTEGRATION_KEY=... SITE_URL=https://your-site.example
